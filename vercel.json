{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "(cd v1 && npm ci --include=dev) && (cd server && npm ci --omit=dev)",
  "buildCommand": "node ferramentas/build-vercel.mjs",
  "outputDirectory": "v1/dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/src/db/migracoes/**"
    }
  }
}
