# =============================================================================
#  GHT4 · servidor — variaveis de ambiente
# -----------------------------------------------------------------------------
#  Copie para `server/.env` e preencha. O `.env` esta no .gitignore: credencial
#  nunca entra no repositorio.
#
#  ATENCAO: nao cole connection string em chat, ticket ou commit. Ela contem a
#  senha do banco. Se uma vazar, rode "Reset database password" no painel do
#  Supabase — trocar a senha invalida a string antiga.
# =============================================================================

# Postgres de verdade. Sem esta variavel, o servidor usa PGlite local
# (Postgres em WebAssembly) — bom para desenvolvimento e teste, insuficiente
# para os benchmarks de escala do adendo.
#
# No Supabase: Project Settings > Database > Connection string > URI.
# Prefira a porta 6543 (pooler, "Transaction") para a API, e a 5432
# (conexao direta) para migrations e ingestao em massa.
#
# DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# Conexao direta, usada por migrations e COPY. Se nao definir, usa DATABASE_URL.
# DATABASE_URL_DIRETA=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Porta e host da API. 127.0.0.1 de proposito: expor para a rede e decisao de
# quem opera, e vem junto com TLS.
# PORTA=3311
# HOST=127.0.0.1

# Tamanho do pool e limite por consulta.
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=60000

# So ligue se estiver atras de um proxy com certificado proprio. Nunca em producao.
# PGSSL_INSEGURO=0

# Banco em memoria (PGlite): some ao encerrar. Bom para demonstracao.
# GHT4_MEMORIA=0

# Nivel de log do Fastify: fatal, error, warn, info, debug, trace
# LOG_NIVEL=info
